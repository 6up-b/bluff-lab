  "control": null,
  "model": "us.anthropic.claude-opus-5-5",
  "provider": "bedrock",
  "effort": "medium",
  "rationale": "Challenge p3 when P(bluff)=p_cards+(1-p_cards)q exceeds a threshold; q comes from branch-specific priors (stock-tag phrases ~0.8, formal single-card ~0.72, else ~0.25) updated online from revealed p3 claims, so stale hypotheses wash out. Threshold drops when we'd be forced to bluff, rises when we can go out honestly. Play all matching cards (up to 3) with a neutral, uniform utterance; bluff single cards only when forced. p2 hypothesis is not actionable from seat p1.",
  "targets": [
   "h_w0002_p3_011 trigger: formal_register & claim_count==1",
   "h_w0002_p3_018 verbal_tell: formal verb/stock tag phrases",
   "p3 base rate q_mean 0.437 with online re-estimation",
   "self play-on loss rate informing challenge threshold"
  ],
  "module_source": "import math\n\nPRIOR_W = 6.0\nTAGS = (\"laying down\", \"submit\", \"as stated\", \"as required\", \"are one\", \"these are one\")\n\n\ndef tag_hit(u):\n    u = (u or \"\").lower()\n    for t in TAGS:\n        if t in u:\n            return True\n    return False\n\n\ndef branch(f):\n    u = f.get(\"utterance\", \"\")\n    if tag_hit(u):\n        return \"tag\"\n    if f.get(\"formal_register\") and f.get(\"claim_count\") == 1:\n        return \"f1\"\n    return \"base\"\n\n\nPRIORS = {\"tag\": 0.80, \"f1\": 0.72, \"base\": 0.25}\n\n\ndef est_q(hist, br):\n    num = PRIORS[br] * PRIOR_W\n    den = PRIOR_W\n    for h in hist:\n        if h.get(\"by\") != \"p3\":\n            continue\n        f = h.get(\"features\") or {}\n        try:\n            if branch(f) != br:\n                continue\n        except Exception:\n            continue\n        p = h.get(\"p_cards\")\n        if p is None:\n            p = (f.get(\"card_math\") or {}).get(\"p_cards\", 0.0)\n        p = min(max(float(p), 0.0), 0.99)\n        b = 1.0 if h.get(\"was_bluff\") else 0.0\n        num += b - p\n        den += 1.0 - p\n    q = num / den if den > 0 else PRIORS[br]\n    return min(max(q, 0.0), 1.0)\n\n\ndef decide(obs):\n    legal = obs.get(\"legal_actions\") or []\n    hand = obs.get(\"my_hand\") or []\n    r = obs.get(\"table_rank\", \"K\")\n    if \"play\" not in legal or not hand:\n        return {\"type\": \"challenge\"}\n    m = [i for i, c in enumerate(hand) if c in (r, \"J\")]\n    pc = obs.get(\"pending_claim\")\n    if pc and \"challenge\" in legal:\n        try:\n            f = pc.get(\"features\") or {}\n            p = float((f.get(\"card_math\") or {}).get(\"p_cards\", 0.0))\n            if p >= 0.999:\n                return {\"type\": \"challenge\"}\n            q = est_q(obs.get(\"revealed_history\") or [], branch(f))\n            pb = p + (1.0 - p) * q\n            thr = 0.5\n            if not m:\n                thr = 0.36\n            elif len(m) >= len(hand) and len(hand) <= 3:\n                thr = 0.62\n            lv = obs.get(\"lives\") or {}\n            if lv.get(\"p1\", 3) <= 1:\n                thr += 0.05\n            if f.get(\"hand_size\", 5) == 0:\n                thr -= 0.1\n            if pb > thr:\n                return {\"type\": \"challenge\"}\n        except Exception:\n            pass\n    if m:\n        cards = m[:3]\n    else:\n        cards = [0]\n    n = len(cards)\n    return {\"type\": \"play\", \"cards\": cards, \"utterance\": str(n) + \" \" + r + (\"s\" if n > 1 else \"\") + \".\"}\n",
